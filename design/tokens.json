{
	"$description": "Bookshelf design tokens. The one source for every port. Edit this file, then run `node tools/build-tokens.mjs` to regenerate design/assets/css/tokens.css, wordpress/theme.json presets and wordpress/styles/lamplight.json.",
	"modes": {
		"light": { "title": "Paper" },
		"dark": { "title": "Lamplight" }
	},
	"color": {
		"base": {
			"name": "Base",
			"light": "#f6f1e7",
			"dark": "#1b1814",
			"note": { "light": "page background: warm paper", "dark": "warm charcoal" }
		},
		"surface": {
			"name": "Surface",
			"light": "#fcf9f3",
			"dark": "#24201b",
			"note": { "light": "cards, panels, inputs" }
		},
		"contrast": {
			"name": "Contrast",
			"light": "#2a241e",
			"dark": "#eee6d8",
			"note": { "light": "body text: warm ink   (13.9:1 on base)", "dark": "14.2:1 on base" }
		},
		"muted": {
			"name": "Muted",
			"light": "#675d52",
			"dark": "#b3a795",
			"note": { "light": "meta, captions        (5.6:1 on base)", "dark": "7.4:1 on base" }
		},
		"accent": {
			"name": "Accent",
			"light": "#9e3d27",
			"dark": "#e59a7e",
			"note": { "light": "links, buttons, stars (5.9:1 on base)", "dark": "8.0:1 on base" }
		},
		"accent-2": {
			"name": "Accent 2",
			"light": "#4a6650",
			"dark": "#9dbfa3",
			"note": { "light": "status, tags: sage    (5.6:1 on base)", "dark": "9.1:1 on base" }
		},
		"border": {
			"name": "Line",
			"wordpressSlug": "line",
			"wordpressSlugReason": "WordPress gives blocks with a border colour the class has-border-color, so a palette colour named border would recolour their text.",
			"light": "#ddd3c3",
			"dark": "#3a332b",
			"note": { "light": "hairlines, dividers (decorative only)" }
		}
	},
	"fontFamily": {
		"heading": {
			"name": "Fraunces",
			"stack": "\"Fraunces\", \"Iowan Old Style\", \"Palatino Linotype\", Georgia, serif"
		},
		"body": {
			"name": "Literata",
			"stack": "\"Literata\", \"Iowan Old Style\", \"Palatino Linotype\", Georgia, serif"
		}
	},
	"fluidViewport": { "min": "360px", "max": "1280px" },
	"fontSize": {
		"small": { "name": "Small", "value": "clamp(0.875rem, 0.85rem + 0.11vw, 0.9375rem)", "note": "14 -> 15px" },
		"medium": { "name": "Medium", "value": "clamp(1.0625rem, 1.01rem + 0.22vw, 1.1875rem)", "note": "17 -> 19px" },
		"large": { "name": "Large", "value": "clamp(1.25rem, 1.14rem + 0.45vw, 1.5rem)", "note": "20 -> 24px" },
		"x-large": { "name": "Extra large", "value": "clamp(1.625rem, 1.38rem + 1.1vw, 2.25rem)", "note": "26 -> 36px" },
		"xx-large": { "name": "Huge", "value": "clamp(2.125rem, 1.6rem + 2.3vw, 3.5rem)", "note": "34 -> 56px" }
	},
	"spacing": {
		"20": { "name": "2X-Small", "value": "0.5rem", "note": "8px" },
		"30": { "name": "X-Small", "value": "1rem", "note": "16px" },
		"40": { "name": "Small", "value": "1.5rem", "note": "24px" },
		"50": { "name": "Medium", "value": "clamp(2rem, 1.8rem + 0.9vw, 2.5rem)", "note": "32 -> 40px" },
		"60": { "name": "Large", "value": "clamp(2.5rem, 2rem + 2.2vw, 4rem)", "note": "40 -> 64px" },
		"70": { "name": "X-Large", "value": "clamp(3.5rem, 2.6rem + 3.6vw, 6rem)", "note": "56 -> 96px" },
		"80": { "name": "2X-Large", "value": "clamp(4.5rem, 3rem + 6.2vw, 8rem)", "note": "72 -> 128px" }
	},
	"width": {
		"content": "680px",
		"wide": "1200px"
	},
	"custom": {
		"line-height-body": { "value": "1.7" },
		"line-height-heading": { "value": "1.15" },
		"radius": { "value": "6px" },
		"radius-cover": { "value": "2px 4px 4px 2px", "note": "a book's spine edge is squarer" },
		"border-width": { "value": "1px" },
		"duration": { "value": "200ms" },
		"easing": { "value": "cubic-bezier(0.23, 1, 0.32, 1)" }
	}
}
