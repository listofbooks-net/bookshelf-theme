{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"color": "#f6f1e7",
					"name": "Base",
					"slug": "base"
				},
				{
					"color": "#fcf9f3",
					"name": "Surface",
					"slug": "surface"
				},
				{
					"color": "#2a241e",
					"name": "Contrast",
					"slug": "contrast"
				},
				{
					"color": "#675d52",
					"name": "Muted",
					"slug": "muted"
				},
				{
					"color": "#9e3d27",
					"name": "Accent",
					"slug": "accent"
				},
				{
					"color": "#4a6650",
					"name": "Accent 2",
					"slug": "accent-2"
				},
				{
					"color": "#ddd3c3",
					"name": "Line",
					"slug": "line"
				}
			]
		},
		"layout": {
			"contentSize": "680px",
			"wideSize": "1200px"
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"name": "Book cover",
					"slug": "cover",
					"shadow": "0 1px 2px rgb(42 36 30 / 0.18), 0 6px 14px -8px rgb(42 36 30 / 0.35)"
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"name": "2X-Small",
					"slug": "20",
					"size": "0.5rem"
				},
				{
					"name": "X-Small",
					"slug": "30",
					"size": "1rem"
				},
				{
					"name": "Small",
					"slug": "40",
					"size": "1.5rem"
				},
				{
					"name": "Medium",
					"slug": "50",
					"size": "clamp(2rem, 1.8rem + 0.9vw, 2.5rem)"
				},
				{
					"name": "Large",
					"slug": "60",
					"size": "clamp(2.5rem, 2rem + 2.2vw, 4rem)"
				},
				{
					"name": "X-Large",
					"slug": "70",
					"size": "clamp(3.5rem, 2.6rem + 3.6vw, 6rem)"
				},
				{
					"name": "2X-Large",
					"slug": "80",
					"size": "clamp(4.5rem, 3rem + 6.2vw, 8rem)"
				}
			],
			"units": [
				"px",
				"em",
				"rem",
				"%",
				"vw",
				"vh"
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"dropCap": true,
			"fluid": {
				"minViewportWidth": "360px",
				"maxViewportWidth": "1280px"
			},
			"fontFamilies": [
				{
					"name": "Fraunces",
					"slug": "heading",
					"fontFamily": "\"Fraunces\", \"Iowan Old Style\", \"Palatino Linotype\", Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Fraunces",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/fraunces/fraunces-latin-standard-normal.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Fraunces",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/fraunces/fraunces-latin-ext-standard-normal.woff2"
							],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						},
						{
							"fontFamily": "Fraunces",
							"fontStyle": "italic",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/fraunces/fraunces-latin-standard-italic.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Fraunces",
							"fontStyle": "italic",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/fraunces/fraunces-latin-ext-standard-italic.woff2"
							],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						}
					]
				},
				{
					"name": "Literata",
					"slug": "body",
					"fontFamily": "\"Literata\", \"Iowan Old Style\", \"Palatino Linotype\", Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Literata",
							"fontStyle": "normal",
							"fontWeight": "200 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/literata/literata-latin-standard-normal.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Literata",
							"fontStyle": "normal",
							"fontWeight": "200 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/literata/literata-latin-ext-standard-normal.woff2"
							],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						},
						{
							"fontFamily": "Literata",
							"fontStyle": "italic",
							"fontWeight": "200 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/literata/literata-latin-standard-italic.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Literata",
							"fontStyle": "italic",
							"fontWeight": "200 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/literata/literata-latin-ext-standard-italic.woff2"
							],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						}
					]
				}
			],
			"fontSizes": [
				{
					"name": "Small",
					"slug": "small",
					"size": "0.9375rem",
					"fluid": {
						"min": "0.875rem",
						"max": "0.9375rem"
					}
				},
				{
					"name": "Medium",
					"slug": "medium",
					"size": "1.1875rem",
					"fluid": {
						"min": "1.0625rem",
						"max": "1.1875rem"
					}
				},
				{
					"name": "Large",
					"slug": "large",
					"size": "1.5rem",
					"fluid": {
						"min": "1.25rem",
						"max": "1.5rem"
					}
				},
				{
					"name": "Extra large",
					"slug": "x-large",
					"size": "2.25rem",
					"fluid": {
						"min": "1.625rem",
						"max": "2.25rem"
					}
				},
				{
					"name": "Huge",
					"slug": "xx-large",
					"size": "3.5rem",
					"fluid": {
						"min": "2.125rem",
						"max": "3.5rem"
					}
				}
			]
		},
		"custom": {
			"line-height-body": "1.7",
			"line-height-heading": "1.15",
			"radius": "6px",
			"radius-cover": "2px 4px 4px 2px",
			"border-width": "1px",
			"duration": "200ms",
			"easing": "cubic-bezier(0.23, 1, 0.32, 1)"
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"spacing": {
			"blockGap": "var:preset|spacing|30",
			"padding": {
				"left": "clamp(1rem, 0.5rem + 2vw, 1.5rem)",
				"right": "clamp(1rem, 0.5rem + 2vw, 1.5rem)"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "var(--wp--custom--line-height-body)"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|accent"
				},
				"typography": {
					"textDecoration": "underline"
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|heading",
					"fontWeight": "500",
					"lineHeight": "var(--wp--custom--line-height-heading)",
					"letterSpacing": "-0.01em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|xx-large"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|x-large"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|large"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var:preset|font-size|medium",
					"fontWeight": "600"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var:preset|font-size|medium",
					"fontWeight": "600"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "600"
				}
			},
			"button": {
				"border": {
					"color": "var:preset|color|accent",
					"radius": "var(--wp--custom--radius)",
					"style": "solid",
					"width": "var(--wp--custom--border-width)"
				},
				"color": {
					"background": "var:preset|color|accent",
					"text": "var:preset|color|base"
				},
				"spacing": {
					"padding": {
						"top": "0.5em",
						"bottom": "0.5em",
						"left": "1.25em",
						"right": "1.25em"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|body",
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "600",
					"lineHeight": "1.2"
				},
				":hover": {
					"border": {
						"color": "var:preset|color|contrast"
					},
					"color": {
						"background": "var:preset|color|contrast",
						"text": "var:preset|color|base"
					}
				},
				":focus": {
					"border": {
						"color": "var:preset|color|contrast"
					},
					"color": {
						"background": "var:preset|color|contrast",
						"text": "var:preset|color|base"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var:preset|color|muted"
				},
				"typography": {
					"fontSize": "var:preset|font-size|small"
				}
			},
			"cite": {
				"typography": {
					"fontStyle": "italic"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|heading",
					"fontSize": "var:preset|font-size|x-large",
					"fontWeight": "500",
					"lineHeight": "1.1",
					"letterSpacing": "-0.015em"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|contrast"
						},
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"color": {
								"text": "var:preset|color|accent"
							}
						}
					}
				}
			},
			"core/site-tagline": {
				"color": {
					"text": "var:preset|color|muted"
				},
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontStyle": "italic"
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "500"
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|contrast"
						},
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"color": {
								"text": "var:preset|color|accent"
							}
						}
					}
				}
			},
			"core/post-date": {
				"color": {
					"text": "var:preset|color|muted"
				},
				"typography": {
					"fontSize": "var:preset|font-size|small"
				}
			},
			"core/post-excerpt": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"lineHeight": "1.6"
				}
			},
			"core/post-author-name": {
				"typography": {
					"fontSize": "var:preset|font-size|small"
				}
			},
			"core/pullquote": {
				"border": {
					"top": {
						"color": "var:preset|color|contrast",
						"style": "solid",
						"width": "var(--wp--custom--border-width)"
					},
					"bottom": {
						"color": "var:preset|color|contrast",
						"style": "solid",
						"width": "var(--wp--custom--border-width)"
					}
				},
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|40",
						"bottom": "var:preset|spacing|40",
						"left": "0",
						"right": "0"
					},
					"margin": {
						"top": "var:preset|spacing|60",
						"bottom": "var:preset|spacing|60"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|heading",
					"fontSize": "var:preset|font-size|x-large",
					"fontStyle": "italic",
					"fontWeight": "400",
					"lineHeight": "1.3"
				},
				"elements": {
					"cite": {
						"color": {
							"text": "var:preset|color|muted"
						},
						"typography": {
							"fontFamily": "var:preset|font-family|body",
							"fontSize": "var:preset|font-size|small",
							"fontStyle": "normal",
							"letterSpacing": "0.06em",
							"textTransform": "uppercase"
						}
					}
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var:preset|color|line",
						"style": "solid",
						"width": "2px"
					}
				},
				"spacing": {
					"padding": {
						"left": "var:preset|spacing|40"
					}
				},
				"typography": {
					"fontStyle": "italic"
				},
				"elements": {
					"cite": {
						"color": {
							"text": "var:preset|color|muted"
						},
						"typography": {
							"fontSize": "var:preset|font-size|small",
							"fontStyle": "normal"
						}
					}
				}
			},
			"core/separator": {
				"color": {
					"text": "var:preset|color|line"
				},
				"border": {
					"width": "var(--wp--custom--border-width) 0 0"
				}
			},
			"core/search": {
				"typography": {
					"fontSize": "var:preset|font-size|small"
				}
			},
			"core/button": {
				"variations": {
					"outline": {
						"border": {
							"color": "var:preset|color|contrast",
							"width": "var(--wp--custom--border-width)"
						},
						"color": {
							"background": "transparent",
							"text": "var:preset|color|contrast"
						},
						"spacing": {
							"padding": {
								"top": "0.5em",
								"bottom": "0.5em",
								"left": "1.25em",
								"right": "1.25em"
							}
						}
					}
				}
			},
			"core/comment-author-name": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "600"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|contrast"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/comment-date": {
				"color": {
					"text": "var:preset|color|muted"
				},
				"typography": {
					"fontSize": "0.8125rem"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|muted"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/comment-content": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"lineHeight": "1.65"
				}
			},
			"core/comment-reply-link": {
				"typography": {
					"fontSize": "0.8125rem",
					"fontWeight": "600"
				}
			},
			"core/table": {
				"typography": {
					"fontSize": "var:preset|font-size|small"
				}
			}
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "Header"
		},
		{
			"area": "footer",
			"name": "footer",
			"title": "Footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-landing",
			"postTypes": [
				"page"
			],
			"title": "Landing page (no title, full width)"
		}
	]
}
