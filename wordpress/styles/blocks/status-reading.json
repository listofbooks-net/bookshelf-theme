{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"title": "Status: Reading",
	"slug": "status-reading",
	"blockTypes": [
		"core/paragraph"
	],
	"styles": {
		"border": {
			"radius": "var(--wp--custom--radius)",
			"style": "solid",
			"width": "var(--wp--custom--border-width)"
		},
		"spacing": {
			"padding": {
				"top": "0.2em",
				"bottom": "0.2em",
				"left": "0.6em",
				"right": "0.6em"
			}
		},
		"typography": {
			"fontSize": "0.8125rem",
			"fontWeight": "600",
			"lineHeight": "1.4"
		},
		"color": {
			"text": "var:preset|color|accent-2"
		}
	}
}
