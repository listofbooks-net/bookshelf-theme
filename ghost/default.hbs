<!doctype html>
<html lang="{{@site.locale}}"{{#match @custom.color_scheme "Paper"}} data-theme="light"{{/match}}{{#match @custom.color_scheme "Lamplight"}} data-theme="dark"{{/match}}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{meta_title}}</title>
  <meta name="color-scheme" content="light dark">
  <link rel="preload" href="{{asset "fonts/fraunces/fraunces-latin-standard-normal.woff2"}}" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{asset "fonts/literata/literata-latin-standard-normal.woff2"}}" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="{{asset "css/readerly.css"}}">
  <link rel="stylesheet" href="{{asset "css/ghost.css"}}">
  <script src="{{asset "js/theme.js"}}"></script>
  <script defer src="{{asset "js/books.js"}}"></script>
  {{ghost_head}}
</head>
<body class="{{body_class}}">
  <a class="skip-link" href="#main">{{t "Skip to content"}}</a>
  {{> "site/header"}}
  <main id="main">
{{{body}}}
  </main>
  {{> "site/footer"}}
  {{ghost_foot}}
</body>
</html>
