{{#if @custom.intro_heading}}
<section class="section section--tight">
      <div class="wrap">
        <div class="intro">
          {{#if @custom.intro_eyebrow}}
          <span class="eyebrow">{{@custom.intro_eyebrow}}</span>
          {{/if}}
          <h1>{{#split @custom.intro_heading separator="*"}}{{#foreach this}}{{#if @even}}<em>{{this}}</em>{{else}}{{this}}{{/if}}{{/foreach}}{{/split}}</h1>
          {{#if @custom.intro_lead}}
          <p class="lead muted">{{@custom.intro_lead}}</p>
          {{/if}}
          {{#if @custom.intro_button_text}}{{#foreach posts limit="1"}}
          <div class="buttons">
            <a class="button" href="{{url}}">{{@custom.intro_button_text}}</a>
            {{#if @custom.secondary_button_text}}{{#if @custom.secondary_button_url}}
            <a class="button button--outline" href="{{@custom.secondary_button_url}}">{{@custom.secondary_button_text}}</a>
            {{/if}}{{/if}}
          </div>
          {{/foreach}}{{/if}}
        </div>
      </div>
    </section>
{{else}}
<h1 class="visually-hidden">{{@site.title}}</h1>
{{/if}}