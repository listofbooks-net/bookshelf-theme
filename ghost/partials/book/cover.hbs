{{#if feature_image}}<img class="cover" srcset="{{img_url feature_image size="s"}} 320w, {{img_url feature_image size="m"}} 600w" sizes="(min-width: 48rem) 16rem, 45vw" src="{{img_url feature_image size="m"}}" width="400" height="600" alt="{{#if described}}{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{t "Cover of {title}" title=title}}{{/if}}{{/if}}" loading="lazy">{{else}}<div class="cover cover--placeholder" role="img" aria-label="{{t "No cover image yet: {title}" title=title}}"><strong>{{title}}</strong>{{#foreach tags visibility="internal"}}{{#match name "~^" "#by:"}}<span>{{split name separator="#by:"}}</span>{{/match}}{{/foreach}}</div>{{/if}}