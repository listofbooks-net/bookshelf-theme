{{#has tag="#reading"}}{{#foreach tags visibility="internal"}}{{#match name "~^" "#on-page:"}}{{#foreach ../tags visibility="internal"}}{{#match name "~^" "#pages:"}}<div class="progress"><progress max="{{split name separator="#pages:"}}" value="{{split ../name separator="#on-page:"}}" aria-label="{{t "Progress through {title}" title=../../title}}"></progress><p class="progress__label"><span>{{t "Page {page} of {pages}" page=(split ../name separator="#on-page:") pages=(split name separator="#pages:")}}</span><span class="od-nowrap" data-percent></span></p></div>{{/match}}{{/foreach}}{{/match}}{{/foreach}}{{/has}}{{#has tag="#did-not-finish"}}{{#foreach tags visibility="internal"}}{{#match name "~^" "#on-page:"}}<p class="book-card__meta">{{t "Stopped at page {page}" page=(split name separator="#on-page:")}}</p>{{/match}}{{/foreach}}{{/has}}