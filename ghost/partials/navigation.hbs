<ul{{#if isSecondary}} class="footer-links"{{else if readerlyFooter}} class="footer-links"{{/if}}>
  {{#foreach navigation}}
  {{#if label}}
  <li><a href="{{url absolute="true"}}"{{#if current}}{{#unless ../isSecondary}}{{#unless ../readerlyFooter}} aria-current="page"{{/unless}}{{/unless}}{{/if}}>{{label}}</a></li>
  {{/if}}
  {{/foreach}}
</ul>